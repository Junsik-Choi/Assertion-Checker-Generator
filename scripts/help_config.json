{
  "pages": [
    {
      "key": "commands",
      "title": "Commands",
      "items": [
        { "cmd": "new", "example": "new", "desc": "Create a new assertion (interactive wizard)", "cmd_color": "green", "example_color": "green", "desc_color": "white" },
        { "cmd": "<number>", "example": "2", "desc": "Load previous session by its number", "cmd_color": "cyan", "example_color": "cyan", "desc_color": "white" },
        { "cmd": "help | h", "example": "help", "desc": "Open/close help overlay (this)", "cmd_color": "white", "example_color": "white", "desc_color": "white" },
        { "cmd": "quit | q", "example": "q", "desc": "Exit the TUI", "cmd_color": "white", "example_color": "white", "desc_color": "white" },

        { "cmd": "set rtl <path>", "example": "set rtl D:/proj/top.sv", "desc": "File: restrict modules to that file; Folder: scan all under it (Tab completion)", "cmd_color": "green", "example_color": "green", "desc_color": "white" },
        { "cmd": "set module <name>", "example": "set module blur_scaler", "desc": "Pick target module (Step 2 also lets you choose)", "cmd_color": "green", "example_color": "green", "desc_color": "white" },
        { "cmd": "set excel <path>", "example": "set excel Data/Assertion_TF.xlsx", "desc": "Reference Excel (auto-detected if found)", "cmd_color": "green", "example_color": "green", "desc_color": "white" },
        { "cmd": "set out <path>", "example": "set out out/assertions", "desc": "Output directory for artifacts", "cmd_color": "green", "example_color": "green", "desc_color": "white" },

        { "cmd": "scan", "example": "scan", "desc": "Parse RTL, populate module/ports/clocks/resets", "cmd_color": "cyan", "example_color": "cyan", "desc_color": "white" },
        { "cmd": "fill / json / sv", "example": "fill", "desc": "Define fill / inputs JSON / SV generation", "cmd_color": "yellow", "example_color": "yellow", "desc_color": "white" },

        { "cmd": "f <substr>", "example": "f den", "desc": "Filter ports or modules (contains)", "cmd_color": "cyan", "example_color": "cyan", "desc_color": "white" },
        { "cmd": "F", "example": "F", "desc": "Clear filter", "cmd_color": "cyan", "example_color": "cyan", "desc_color": "white" },
        { "cmd": "n / N", "example": "n", "desc": "Next / previous page (wrap)", "cmd_color": "cyan", "example_color": "cyan", "desc_color": "white" },
        { "cmd": "prev / back", "example": "prev", "desc": "Go to previous onboarding step", "cmd_color": "cyan", "example_color": "cyan", "desc_color": "white" },
        { "cmd": "Tab (path)", "example": "D:/proj/ + Tab", "desc": "Show candidates, extend common prefix; if many: Tab pages candidates", "cmd_color": "cyan", "example_color": "cyan", "desc_color": "white" }
      ]
    },
    {
      "key": "signals",
      "title": "Condition Signals (ms)",
      "items": [
        { "cmd": "ms name = expr", "example": "ms valid = (1||2)&&3", "desc": "Create a condition signal. '=' optional.", "cmd_color": "magenta", "example_color": "magenta", "desc_color": "white" },
        { "cmd": "aliases", "example": "1,2.. → inputs; o1,o2.. → outputs", "desc": "Numeric refs map to Inputs/Inouts; oN maps to Outputs/Inouts.", "cmd_color": "yellow", "example_color": "yellow", "desc_color": "white" },
        { "cmd": "width", "example": "I_BUS[7:0]  /  ... 4", "desc": "Width from [msb:lsb] or trailing number; default 1.", "cmd_color": "yellow", "example_color": "yellow", "desc_color": "white" },
        { "cmd": "logical", "example": "&&, ||, ! → 1-bit result", "desc": "Logical operators always produce 1-bit result.", "cmd_color": "green", "example_color": "green", "desc_color": "white" },
        { "cmd": "bitwise", "example": "&, |, ^ → multi-bit", "desc": "Bitwise ops require bit width: 'ms name expr <width>'", "cmd_color": "green", "example_color": "green", "desc_color": "white" },
        { "cmd": "refs", "example": "ms combined (valid && eq)", "desc": "You can reference previously defined conditions (cycle not allowed).", "cmd_color": "yellow", "example_color": "yellow", "desc_color": "white" },
        { "cmd": "excel", "example": "L/M/N from L8", "desc": "Appends name/expr/bits to session Excel Define sheet.", "cmd_color": "green", "example_color": "green", "desc_color": "white" },
        { "cmd": "errors", "example": "unknown signal / unmatched ']' / cycle", "desc": "Invalid expressions rejected; ms page is highlighted and error shown.", "cmd_color": "red", "example_color": "red", "desc_color": "white" }
      ]
    },
    {
      "key": "assertion_wizard",
      "title": "Assertion Wizard (new)",
      "items": [
        { "cmd": "new", "example": "new", "desc": "Step 1: Select Type - Enter number to choose Assertion type (e.g., 1)", "cmd_color": "green", "example_color": "green", "desc_color": "white" },
        { "cmd": "Type Selection", "example": "1", "desc": "[Plugin_missing] / [Excel_missing] - Only fully ready types can be created", "cmd_color": "yellow", "example_color": "yellow", "desc_color": "white" },
        
        { "cmd": "Step 2: Field Input", "example": "", "desc": "Enter fields in order. Left: form, Right: real-time preview", "cmd_color": "green", "example_color": "white", "desc_color": "white" },
        { "cmd": "Enter field#", "example": "1", "desc": "Show selection options for current field (Ports/Params/MS Signals)", "cmd_color": "cyan", "example_color": "cyan", "desc_color": "white" },
        { "cmd": "set field# value", "example": "set 1 clk", "desc": "Set value directly (e.g., port name, option name)", "cmd_color": "cyan", "example_color": "cyan", "desc_color": "white" },
        { "cmd": "b", "example": "b", "desc": "Go back to previous field", "cmd_color": "cyan", "example_color": "cyan", "desc_color": "white" },
        { "cmd": "done", "example": "done", "desc": "Validate required fields, then proceed to Step 3", "cmd_color": "green", "example_color": "green", "desc_color": "white" },
        
        { "cmd": "Step 3: Review & Create", "example": "", "desc": "Final check - all inputs and preview displayed", "cmd_color": "green", "example_color": "white", "desc_color": "white" },
        { "cmd": "confirm", "example": "confirm", "desc": "Create assertion (auto-saved to Excel sheet)", "cmd_color": "green", "example_color": "green", "desc_color": "white" },
        
        { "cmd": "q", "example": "q", "desc": "Always press 'q' to exit and cancel wizard", "cmd_color": "red", "example_color": "red", "desc_color": "white" }
      ]
    },
