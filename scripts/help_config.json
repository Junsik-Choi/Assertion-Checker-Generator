{
  "pages": [
    {
      "key": "commands",
      "title": "Commands",
      "items": [
        { "cmd": "new", "example": "new", "desc": "Create a new assertion (interactive wizard)", "cmd_color": "green", "example_color": "green", "desc_color": "white" },
        { "cmd": "gen | if | inst", "example": "gen", "desc": "Generate interface/instance files (unified command - all aliases work)", "cmd_color": "green", "example_color": "green", "desc_color": "white" },
        { "cmd": "<number>", "example": "2", "desc": "Load previous session by its number", "cmd_color": "cyan", "example_color": "cyan", "desc_color": "white" },
        { "cmd": "help | h", "example": "help", "desc": "Open/close help overlay (this)", "cmd_color": "white", "example_color": "white", "desc_color": "white" },
        { "cmd": "quit | q", "example": "q", "desc": "Exit the TUI", "cmd_color": "white", "example_color": "white", "desc_color": "white" },
        { "cmd": "del ms <name>", "example": "del ms valid", "desc": "Delete MS signal", "cmd_color": "red", "example_color": "red", "desc_color": "white" },
        { "cmd": "del assertion <#>", "example": "del assertion 3", "desc": "Delete assertion by index", "cmd_color": "red", "example_color": "red", "desc_color": "white" },
        { "cmd": "f <substr>", "example": "f den", "desc": "Filter ports or modules (contains)", "cmd_color": "cyan", "example_color": "cyan", "desc_color": "white" },
        { "cmd": "F", "example": "F", "desc": "Clear filter", "cmd_color": "cyan", "example_color": "cyan", "desc_color": "white" },
        { "cmd": "n / N", "example": "n", "desc": "Next / previous page (wrap)", "cmd_color": "cyan", "example_color": "cyan", "desc_color": "white" }
      ]
    },
    {
      "key": "signals",
      "title": "Condition Signals (ms) & Parameters",
      "items": [
        { "cmd": "ms name = expr", "example": "ms valid = (i1||i2)&&i3", "desc": "Create condition signal. '=' optional.", "cmd_color": "magenta", "example_color": "magenta", "desc_color": "white" },
        { "cmd": "param name=val", "example": "param WIDTH=8", "desc": "Add/override module parameter", "cmd_color": "magenta", "example_color": "magenta", "desc_color": "white" },
        { "cmd": "del ms <name>", "example": "del ms valid", "desc": "Delete MS signal by name", "cmd_color": "red", "example_color": "red", "desc_color": "white" },
        { "cmd": "del assertion <#>", "example": "del assertion 3", "desc": "Delete assertion by index number", "cmd_color": "red", "example_color": "red", "desc_color": "white" },
        { "cmd": "───────────────", "example": "─────────────────────────", "desc": "─────────────────────────────────────────────", "cmd_color": "white", "example_color": "white", "desc_color": "white" },
        { "cmd": "INPUT signals", "example": "i1, i2, i3, ...", "desc": "Reference input port by index", "cmd_color": "cyan", "example_color": "green", "desc_color": "white" },
        { "cmd": "OUTPUT signals", "example": "o1, o2, o3, ...", "desc": "Reference output port by index", "cmd_color": "cyan", "example_color": "green", "desc_color": "white" },
        { "cmd": "PARAMETER values", "example": "p1, p2, p3, ...", "desc": "Reference parameter by index", "cmd_color": "cyan", "example_color": "green", "desc_color": "white" },
        { "cmd": "CLOCK signals", "example": "c1, c2, c3, ...", "desc": "Reference clock signal by index", "cmd_color": "cyan", "example_color": "green", "desc_color": "white" },
        { "cmd": "RESET signals", "example": "r1, r2, r3, ...", "desc": "Reference reset signal by index", "cmd_color": "cyan", "example_color": "green", "desc_color": "white" },
        { "cmd": "LEGACY (plain #)", "example": "1, 2, 3, ...", "desc": "Plain numbers map to inputs (i1, i2, ...)", "cmd_color": "cyan", "example_color": "green", "desc_color": "white" },
        { "cmd": "───────────────", "example": "─────────────────────────", "desc": "─────────────────────────────────────────────", "cmd_color": "white", "example_color": "white", "desc_color": "white" },
        { "cmd": "Combined #1", "example": "(i1 || i2) && c1", "desc": "Use inputs and clock together", "cmd_color": "magenta", "example_color": "green", "desc_color": "white" },
        { "cmd": "Combined #2", "example": "i1 && !i2 && r1", "desc": "Use input with reset (negation)", "cmd_color": "magenta", "example_color": "green", "desc_color": "white" },
        { "cmd": "Combined #3", "example": "o1 && o3", "desc": "Multiple output signals", "cmd_color": "magenta", "example_color": "green", "desc_color": "white" },
        { "cmd": "Combined #4", "example": "p1 > 0 && p2 < 100", "desc": "Parameter comparisons", "cmd_color": "magenta", "example_color": "green", "desc_color": "white" },
        { "cmd": "Combined #5", "example": "i1 || o2 || p1 || c1 || r2", "desc": "All signal types together", "cmd_color": "magenta", "example_color": "green", "desc_color": "white" },
        { "cmd": "───────────────", "example": "─────────────────────────", "desc": "─────────────────────────────────────────────", "cmd_color": "white", "example_color": "white", "desc_color": "white" },
        { "cmd": "Bit width [N:0]", "example": "i1[7:0] && i2[15:8]", "desc": "Specify bit ranges from ports", "cmd_color": "cyan", "example_color": "green", "desc_color": "white" },
        { "cmd": "Bit width #", "example": "ms expr 4", "desc": "Result width (1=logical, 4=bitwise)", "cmd_color": "cyan", "example_color": "green", "desc_color": "white" },
        { "cmd": "Auto-saved", "example": "to Define sheet", "desc": "Expressions saved in session Excel", "cmd_color": "green", "example_color": "green", "desc_color": "white" }
      ]
    },
    {
      "key": "assertion_wizard",
      "title": "Assertion Wizard (new)",
      "items": [
        { "cmd": "new", "example": "new", "desc": "Step 1: Select Type - Enter number to choose Assertion type (e.g., 1)", "cmd_color": "green", "example_color": "green", "desc_color": "white" },
        { "cmd": "Type Selection", "example": "1", "desc": "[Plugin_missing] / [Excel_missing] - Only fully ready types can be created", "cmd_color": "yellow", "example_color": "yellow", "desc_color": "white" },
        
        { "cmd": "Step 2: Field Input", "example": "", "desc": "Enter fields in order. Left: form, Right: real-time preview", "cmd_color": "green", "example_color": "white", "desc_color": "white" },
        { "cmd": "Enter field#", "example": "1", "desc": "Show selection options for current field (Ports/Params/MS Signals)", "cmd_color": "cyan", "example_color": "cyan", "desc_color": "white" },
        { "cmd": "set field# value", "example": "set 1 clk", "desc": "Set value directly (e.g., port name, option name)", "cmd_color": "cyan", "example_color": "cyan", "desc_color": "white" },
        { "cmd": "b", "example": "b", "desc": "Go back to previous field", "cmd_color": "cyan", "example_color": "cyan", "desc_color": "white" },
        { "cmd": "done", "example": "done", "desc": "Validate required fields, then proceed to Step 3", "cmd_color": "green", "example_color": "green", "desc_color": "white" },
        
        { "cmd": "Step 3: Review & Create", "example": "", "desc": "Final check - all inputs and preview displayed", "cmd_color": "green", "example_color": "white", "desc_color": "white" },
        { "cmd": "confirm", "example": "confirm", "desc": "Create assertion (auto-saved to Excel sheet)", "cmd_color": "green", "example_color": "green", "desc_color": "white" },
        
        { "cmd": "q", "example": "q", "desc": "Always press 'q' to exit and cancel wizard", "cmd_color": "red", "example_color": "red", "desc_color": "white" }
      ]
    },
    {
      "key": "file_generation",
      "title": "File Generation (gen)",
      "items": [
        { "cmd": "gen", "example": "gen", "desc": "Generate interface/instance files from Excel data", "cmd_color": "green", "example_color": "green", "desc_color": "white" },
        { "cmd": "───────────────", "example": "─────────────────────────", "desc": "─────────────────────────────────────────────", "cmd_color": "white", "example_color": "white", "desc_color": "white" },
        { "cmd": "Step 1: Filename", "example": "Enter output file name", "desc": "Name without extension (e.g., 'my_veri')", "cmd_color": "cyan", "example_color": "green", "desc_color": "white" },
        { "cmd": "Step 2: File Type", "example": "Choose 1 or 2 or 3", "desc": "1=Interface(.if.sv) 2=Instance(.inst.sv) 3=Both", "cmd_color": "cyan", "example_color": "green", "desc_color": "white" },
        { "cmd": "Step 3: Data Source", "example": "Select assertions/signals", "desc": "Choose which Define/Assertion data to include", "cmd_color": "cyan", "example_color": "green", "desc_color": "white" },
        { "cmd": "Step 4: Preview", "example": "View & confirm", "desc": "Review generated code before saving", "cmd_color": "cyan", "example_color": "green", "desc_color": "white" },
        { "cmd": "───────────────", "example": "─────────────────────────", "desc": "─────────────────────────────────────────────", "cmd_color": "white", "example_color": "white", "desc_color": "white" },
        { "cmd": "Output: Interface", "example": "output/*.if.sv", "desc": "SystemVerilog interface file with assertions", "cmd_color": "magenta", "example_color": "green", "desc_color": "white" },
        { "cmd": "Output: Instance", "example": "output/*.inst.sv", "desc": "SystemVerilog instance file with binding", "cmd_color": "magenta", "example_color": "green", "desc_color": "white" },
        { "cmd": "Done or b", "example": "done / b", "desc": "Finish generation (b=back to Step 3)", "cmd_color": "yellow", "example_color": "yellow", "desc_color": "white" }
      ]
    },
